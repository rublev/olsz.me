{
  // Place your frontend-ts workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
  // description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
  // is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
  // used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
  // $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
  // Placeholders with the same ids are connected.
  // Example:
  "Console log": {
    "scope": "javascript,typescript",
    "prefix": "warn",
    "body": ["console.log('$1',$1); ${2:// }$3", "$4"],
    "description": "Log output to console",
  },
  "Console warn": {
    "scope": "javascript,typescript",
    "prefix": "warn",
    "body": ["console.warn('$1',$1); ${2:// }$3", "$4"],
    "description": "Log output to console",
  },
  "Icon Component": {
    "scope": "vue,html,typescript,javascript",
    "prefix": "icon",
    "body": [
      "<Icon name=\"${1:svg}:${2:}\" class=\"${3:h-6 w-auto} ${4}\" ${0}/>",
    ],
    "description": "Insert Icon component with prefix, name, and classes",
  },
  "Inline Border Style": {
    "scope": "vue,html,typescript,javascript,css",
    "prefix": "br",
    "body": ["style=\"border: ${1:2}px solid ${2:red};\"${0}"],
    "description": "Insert inline border style with thickness and color",
  },
  "Inline Style": {
    "scope": "vue,html,typescript,javascript,css",
    "prefix": "st",
    "body": ["style=\"${1:property}:${2:val};\"${0}"],
    "description": "Insert inline style with property and value",
  },
  "PixelRounded Component": {
    "scope": "vue,html,typescript,javascript",
    "prefix": "pixel",
    "body": [
      "<PixelRounded",
      "  :radius=\"${1:8}\"",
      "  :multiplier=\"${2:4}\"",
      "  ${3::border-width=\"${4:1}\"}",
      "  ${5:border-color=\"${6:#0099ff}\"}",
      "  ${7:drop-shadow}",
      "  ${8::drop-shadow-x=\"${9:5}\"}",
      "  ${10::drop-shadow-y=\"${11:5}\"}",
      "  ${12:drop-shadow-color=\"${13:#000000}\"}",
      ">",
      "  ${0:<div>Content</div>}",
      "</PixelRounded>",
    ],
    "description": "Insert PixelRounded component with customizable props",
  },
}
