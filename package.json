{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev-host": "nuxt dev --host",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare && pnpm simple-git-hooks install",
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:js": "eslint . --fix --config eslint.config.ts",
    "lint:style": "stylelint **/*.{vue,css} --fix --ignore-path .gitignore",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "clean": "git clean -fdx -e .env"
  },
  "dependencies": {
    "@antfu/eslint-config": "5.4.1",
    "@nuxt/devtools": "2.6.5",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "1.11.0",
    "@nuxt/scripts": "0.11.13",
    "@nuxt/ui": "4.0.0",
    "@tailwindcss/vite": "^4.1.13",
    "@vueuse/core": "13.9.0",
    "@vueuse/nuxt": "13.9.0",
    "eslint": "^9.36.0",
    "eslint-plugin-better-tailwindcss": "3.7.9",
    "eslint-plugin-comment-length": "^2.2.2",
    "lint-staged": "16.2.0",
    "nuxt": "^4.1.2",
    "nuxt-eslint-auto-explicit-import": "^0.1.1",
    "simple-git-hooks": "2.13.1",
    "stylelint": "16.24.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "vue-tsc": "3.0.8"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dlx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,mjs,vue}": [
      "eslint --fix --config eslint.config.ts"
    ],
    "*.{css,vue}": "stylelint --fix"
  }
}