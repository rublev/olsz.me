{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "clean": "git clean -fdx -e .env",
    "dev": "nuxt dev",
    "dev-host": "nuxt dev --host --no-qr",
    "fixall": "pnpm format && pnpm lint",
    "format": "prettier . --write",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "pnpm lint:js && pnpm lint:style",
    "lint:js": "eslint . --fix --config eslint.config.ts",
    "lint:style": "stylelint **/*.{vue,css} --fix --ignore-path .stylelintignore",
    "preview": "nuxt preview",
    "preview-build": "nuxt build && nuxt preview",
    "typecheck": "nuxt typecheck"
  },
  "browserslist": [
    ">0.3%, defaults, last 2 versions, not dead",
    "iOS >= 12",
    "Safari >= 12"
  ],
  "dependencies": {
    "@antfu/eslint-config": "6.0.0",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/eslint": "1.9.0",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^1.11.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vueuse/core": "13.9.0",
    "@vueuse/nuxt": "13.9.0",
    "eslint-plugin-better-tailwindcss": "3.7.10",
    "eslint-plugin-comment-length": "^2.2.2",
    "nuxt": "^4.1.3",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@nuxt/devtools": "2.6.5",
    "@nuxt/scripts": "0.13.0",
    "eslint": "^9.37.0",
    "nuxt-eslint-auto-explicit-import": "^0.1.1",
    "prettier": "^3.6.2",
    "sass": "^1.93.2",
    "stylelint": "16.25.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "39.0.1",
    "vue-tsc": "3.1.1"
  },
  "packageManager": "pnpm@10.18.3"
}
